# Environment variables (contains sensitive data)
.env
.env.local
.env.production

# Discord & API secrets
*.token
config.json
secrets.json

# User data files (may contain sensitive league info)
user_leagues.json
league_data.json
user_data.json

# docs/ is for private working notes (session handoffs, scratch analysis --
# already caught by the *.md rule below too) -- but docs/screenshots/ is
# the README's own image source and must stay trackable, or README.md's
# <img> tags break for anyone who doesn't already have those PNGs locally.
docs/*
!docs/screenshots/

# Downloaded player headshots / team logos (fetched on demand, not source)
cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Logs (may contain sensitive data)
logs/
*.log
pm2.log

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# PM2 files
.pm2/
ecosystem.config.js

# Backup files
*.bak
*.backup

# Claude
*.md
